msgid "WooCommerce Data Settings"
msgstr "WooCommerce ડેટા સેટિંગ્સ"

msgid "Form Feed Settings"
msgstr "ફોર્મ ફીડ સેટિંગ્સ"

msgid ""
"You`re using GSheetConnector for WooCommerce Lite. To unlock more features "
"consider "
msgstr ""
"તમે GSheetConnector for WooCommerce Lite નો ઉપયોગ કરી રહ્યા છો. વધુ ફીચર્સ અનલૉક કરવા "
"માટે વિચાર કરો"

msgid "Unlock Advance Features of GSheetConnector for WooCommerce Pro"
msgstr "GSheetConnector for WooCommerce Pro ના આગેવાની ફીચર્સ અનલૉક કરો"

msgid ""
"Use advanced features like Manual Authentication and automatic field mapping, no "
"need to create columns in Google Sheets manually. Choose only the fields you need "
"with simple toggles, use advanced tags, sync past form entries, and get priority "
"support."
msgstr ""
"હેન્ડલ ઓથેન્ટિકેશન અને ઓટોમેટિક ફીલ્ડ મેપિંગ જેવા આગેવાન ફીચર્સનો ઉપયોગ કરો, Google Sheets માં "
"કૉલમ બનાવવા માટે જરૂર નથી. સરળ ટોગલ્સ સાથે માત્ર કરે સૂચકો પસંદ કરો, આગેવાની ટૅગ્સનો ઉપયોગ "
"કરો, ભૂતપૂર્વ ફોર્મ એન્ટ્રીઓનો સમન્વય કરો અને પ્રાથમિકતા ટેકનિકલ સહાય મેળવો."

msgid "Feed Settings (PRO)"
msgstr "ફીડ સેટિંગ્સ (PRO)"

msgid "Order Status Sheet Tabs"
msgstr "ઓર્ડર સ્થાન પત્રક ટેબ્સ"

msgid "Custom Order Sheet Tabs"
msgstr "કસ્ટમ ઓર્ડર પત્રક ટેબ્સ"

msgid "Sync Additional Sheet Tabs"
msgstr "અતિરેક પત્રક ટેબ્સ સમન્વય કરો"

msgid "How Orders Are Synced"
msgstr "ઓર્ડરો કેવી રીતે સમન્વયિત થાય છે"

msgid "Order & Product Category Filter"
msgstr "ઓર્ડર અને ઉત્પાદન શ્રેણી ફિલ્ટર"

msgid "2-Way Sync"
msgstr "2-ફટકો સમન્વય"

msgid "Add Extra Google Sheet Columns"
msgstr "વધુ Google પત્રક કૉલમ ઉમેરો"

msgid "Cron Settings "
msgstr "ક્રોન સેટિંગ્સ"

msgid "Upgrad Now"
msgstr "હવે અપગ્રેડ કરો"

msgid "Free vs Pro"
msgstr "મફત અને પ્રો"

msgid "Google Sheet Not Connected"
msgstr "ગૂગલ શીટ જોડાયેલી નથી."

msgid "Unable to authenticate with the Service Account."
msgstr "સેવા ખાતા સાથે પ્રમાણિત કરવામાં અસક્ષમ."

msgid ""
"No spreadsheets found. Share your Google Sheet with the service account email and "
"grant Editor access."
msgstr ""
"કોઈ સ્પ્રેડશીટ્સ મળતી નથી. તમારા Google પત્રકને સેવામાં જોગવાઈ ઈમેલ સાથે શેयर કરો અને સંપાદકની "
"ઍક્સેસ મંજૂર કરો."

msgid ""
"Connect WooCommerce to Google Sheets using a secure service account. Upload your "
"JSON credentials and share your spreadsheet with the service account email to "
"enable syncing."
msgstr ""
"સુરક્ષિત સેવા ખાતા સાથે Google Sheets ને WooCommerce સાથે જોડો. તમારા JSON પ્રમાણપત્રો "
"અપલોડ કરો અને તાલમેલને સક્રિય કરવા માટે તમારા સ્પ્રેડશીટને સેવા ખાતા ઈમેલ સાથે શેર કરો."

msgid "Are you sure you want to remove the saved service account credentials?"
msgstr "શું તમારે સાચવેલ સેવા ખાતા પ્રમાણપત્રો દૂર કરવા માંગતા હો?"

msgid ""
"Click Create Service Account and enter a meaningful name like ex.WooCommerce "
"GSheet."
msgstr ""
"સેવા ખાતા સર્જો ઓનલાઇન ક્લિક કરો અને ઉદાહરણ તરીકે ખૂબ જ અર્થપૂર્ણ નામ દાખલ કરો: ઉદા. "
"WooCommerce GSheet."

msgid "Step-6 Upload JSON Key in WooCommerce"
msgstr "કદમ-6 WooCommerce માં JSON કી અપલોડ કરો"

msgid ""
"Follow these step-by-step instructions to create and configure your Google service "
"account and securely connect it with WooCommerce."
msgstr ""
"તમારા Google સેવા ખાતાને બનાવવા અને રૂપરેખાંકિત કરવા માટે આ પગલાં દર્શાવો અને તેને WooCommerce "
"સાથે સુરક્ષિત રીતે જોડો."

msgid " Google Sheets Integration for WooCommerce"
msgstr "Google Sheets ને WooCommerce માટેનું સંકલન"

msgid ""
"Sign in with your Google account to connect WooCommerce with Google Sheets. Once "
"connected, your data syncs based on your settings. Learn more in the documentation"
msgstr ""
"તમારા Google ખાતા સાથે સાઇન ઇન કરો કે જેથી WooCommerce ને Google Sheets સાથે જોડવો. "
"એકવાર જોડાઇ ગયા બાદ, તમારું ડેટા તમારા સેટિંગ્સ અનુસાર સમન્વયિત થાય છે. દસ્તાવેજીમાં વધુ જાણો"

msgid ""
"<p class=\"fw-400 text-dark\"><strong>Google Drive</strong> and <strong>Google "
"Sheets</strong> permissions were not granted during authentication with Google.</"
"p>\n"
"                  <p class=\"fw-400 text-dark\"><strong>Refer to Step 4 in the "
"Connection Guide shown alongside.</strong><br> Then, deactivate the connection and "
"re-authorize it, ensuring both Google Drive and Google Sheets permissions are "
"enabled.</p>"
msgstr ""
"<p class=\"fw-400 text-dark\"><strong>Google ડ્રાઈવે</strong> તથા <strong>Google "
"પત્રક</strong> નો પ્રેરણાત્મક સમય દરમિયાન મંજૂર કરવાના હોય તો તે આપવામાં નથી.</p>\n"
"                    <p class=\"fw-400 text-dark\"><strong>સાથે દર્શાવેલા કનેક્શન "
"માર્ગદર્શિકાના પગલાં 4 ને જુઓ.</strong><br> પછી,સંયમેંતને ડિસેઇવેટ કરો અને નવું કરવા માટે પૃથ્વી "
"બનાવો, જેમાં Google ડ્રાઈવ અને Google પત્રકની મંજૂરી સક્રિય હોવાનું ખાતરી કરો.</p>"

msgid ""
"Your Google account has been successfully connected. You are now ready to sync "
"your WooCommerce data with Google Sheets securely and automatically."
msgstr ""
"Ваш аккаунт Google был успешно подключен. Вы теперь готовы на альтернативы данных "
"WooCommerce с Google Sheets безопасно и автоматически."

msgid "Map WooCommerce Fields"
msgstr "WooCommerce ક્ષેત્રો નકામા"

msgid "Enable Order Sync"
msgstr "ઓર્ડર સમન્વય સક્રિય કરો"

msgid "Are you sure you want to deactivate Google Sheets integration?"
msgstr "શું તમે Google Sheets એકતા રદ કરવા માંગો છો?"

msgid ""
"Connect WooCommerce to Google Sheets using your own Google Cloud project. Ideal "
"for advanced users who need full API control and custom OAuth setup."
msgstr ""
"તમારા પોતાની Google ક્લાઉડ પ્રોજેક્ટનો ઉપયોગ કરીને Google Sheets ને WooCommerce સાથે "
"જોડો. પૂરા API નિયંત્રણ અને કસ્ટમ OAuth સેટઅપની જરૂર હોય ત્યારે આ શ્રેષ્ઠ છે."

msgid ""
"Connect WooCommerce to Google Sheets using a Service Account for automated syncing "
"without manual login."
msgstr "સ્વચાલિત સમન્વય માટે સેવા ખાતા સાથે Google Sheets ને WooCommerce સાથે જોડવો."

msgid "Control WooCommerce sync visibility"
msgstr "WooCommerce સમન્વય વિઝિબિલિટી નિયંત્રણ"

msgid ""
"Control which user roles can access and manage WooCommerce Google Sheets "
"integration."
msgstr ""
"કયા વપરાશકર્તા ભાષા કોલ માટે WooCommerce Google Sheets એકતાને ઍક્સેસ અને નિયંત્રિત કરી શકે "
"છે."

msgid "Do not enable on live production websites without proper backups."
msgstr "યોગ્ય બેકઅપ વગર જીવંત ઉત્પાદન વેબસાઇટ પર સક્રિય નહીં કરો."

msgid "Description Input Format Settings"
msgstr "વર્ણન ઇનપુટ ફોર્મેટ સેટિંગ્સ"

msgid ""
"Enable this option to allow HTML formatting in Product Description and Short "
"Description fields. When enabled, HTML content from the sheet will be imported as "
"is. Disable it to use plain text only."
msgstr ""
"ફોર્મેટને મંજૂરી આપવાથી ઉત્પાદનના વર્ણન અને ટૂંકા વર્ણન ક્ષેત્રોમાં HTML ફોર્મેટિંગની અનુમતિ મળે છે. "
"જ્યારે સક્રિય કરેલું હોય, ત્યારે શીટમાંથી HTML સમાન રીતે આયાત કરવામાં આવશે. તેને બંધ કરવા માટે "
"માત્ર સાદા ટેક્સ્ટનો ઉપયોગ કરો."

msgid "Enable HTML Formatting for Description Fields"
msgstr "વર્ણન ક્ષેત્રો માટે HTML ફોર્મેટિંગ સક્રિય કરો"

msgid ""
"Allow HTML content in Product Description and Short Description fields during "
"import."
msgstr "આયાત દરમિયાન ઉત્પાદન વર્ણન અને ટૂંકા વર્ણન ક્ષેત્રોમાં HTML સામગ્રીને મંજૂરી આપો."

msgid "HTML Formatting Guide"
msgstr "HTML ફોર્મેટિંગ માર્ગદર્શિકા"

msgid ""
"Enable this option to allow HTML content in Product Description and Short "
"Description fields."
msgstr "ફોર્મેટને મંજૂરી આપવા માટે આ વિકલ્પ સક્રિય કરો તે ઉત્પાદન વર્ણન અને ટૂંકા વર્ણન ક્ષેત્રોમાં."

msgid ""
"When enabled, HTML tags from the sheet (e.g., <p>, <br>, <strong>) will be "
"imported as is."
msgstr ""
"જ્યાં સક્રિય કરેલા હોય ત્યારે શીટમાંથી HTML ટૅગ્સ (જેમ કે <p>, <br>, <strong>) સમાન રીતે આયાત "
"કરવામાં આવશે."

msgid "Disable this option to import plain text without HTML formatting."
msgstr "HTML ફોર્મેટિંગ વગર સાદી ટેક્સ્ટ આયાત કરવા માટે આ વિકલ્પ બંધ કરો."

msgid "Use this option only if your sheet contains valid HTML content."
msgstr "જ્યારે તમારી શીટમાં આયોગ્ય HTML સામગ્રી હોય ત્યારે માત્ર આ વિકલ્પનો ઉપયોગ કરો."

msgid ""
"View detailed information about your plugin, server, and WordPress setup for "
"troubleshooting and support.\n"
"        "
msgstr ""
"તમારા પ્લોગિન, સર્વર અને WordPress રૂપરેખાંકન વિશેની વિગતવાર માહિતી જુઓ સંસાધનની મુશ્કેલીઓ અને "
"ટેકનિકલ સહાય માટે."

msgid "Loading..."
msgstr "લોડ કરી રહ્યા છીએ..."

msgid "Credentials Saved"
msgstr "પ્રમાણપત્રો સાચવ્યા"

msgid ""
"Sync WooCommerce data with Google Sheets in real-time effortlessly and accurately."
msgstr ""
"તમે તમારા WooCommerce ડેટાને Google Sheets સાથે વાસ્તવિક સમયે સરળતાથી અને ચોકસાઈથી "
"સમન્વયિત કરો."

msgid "Integration of WooCommerce with Google Sheet"
msgstr "Google પત્રક સાથે WooCommerce નો સંકલન"

msgid "WooCommerce Data Settings – PRO Version"
msgstr "WooCommerce ડેટા સેટિંગ્સ - PRO સંસ્કરણ"

msgid "Feed Settings  – PRO Version"
msgstr "ફીડ સેટિંગ્સ - PRO સંસ્કરણ"

msgid "Settings Tab – PRO Version"
msgstr "સેટિંગ્સ ટેબ - PRO સંસ્કરણ"

msgid "Role Settings – PRO Version"
